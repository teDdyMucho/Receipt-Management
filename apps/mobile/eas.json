{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_DEFAULT_SERVER_URL": "https://lionrock-receipts.expo.app" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_DEFAULT_SERVER_URL": "https://lionrock-receipts.expo.app" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6835492954" }
    }
  }
}
