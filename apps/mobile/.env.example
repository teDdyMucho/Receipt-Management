# Public values, baked into the build. Never put a secret here.
# Leave the API URL empty to run the app without a server (receipts stay on the phone).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_APP_VERSION=1.0.0

# Server-only (put the real values in .env.local, which git ignores).
# Used by the AI extraction route. Never add an EXPO_PUBLIC_ prefix to these.
OPENAI_API_KEY= 


VITE_SUPABASE_URL=